{
  "name": "textile.io",
  "version": "1.0.0",
  "description": "textile.io",
  "license": "We Are Set, Inc",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "run-p serve watch:*",
    "clean": "rimraf dist/{css/*,js/*,images/*}",
    "autoprefixer": "postcss -u autoprefixer -r dist/css/*",
    "scss": "node-sass --output-style compressed -o dist/css src/scss",
    "lint": "eslint src/js || true",
    "lint-scss": "stylelint src/scss/*.scss --syntax scss || true",
    "static:html": "cp -r src/index.html dist",
    "static:wellknown": "cp -r .well-known dist/",
    "static": "run-s static:*",
    "imagemin": "run-s imagebase imagefav imageshots imagelogos",
    "imagebase": "imagemin src/images/* -o dist/images",
    "imagelogos": "imagemin src/images/clients-partners/* -o dist/images/clients-partners",
    "imagefav": "imagemin src/images/favicon/* -o dist/images/favicon",
    "imageshots": "imagemin src/images/screenshots/* -o dist/images/screenshots",
    "serve": "browser-sync start --no-ghost-mode --server \"dist/\" --files \"dist/css/*.css, dist/js/*.js, **/*.html, !node_modules/**/*.html\"",
    "build:css": "run-s lint-scss scss autoprefixer",
    "build:js": "run-s lint",
    "build:images": "run-s imagemin",
    "build:static": "run-s static",
    "build": "run-s build:*",
    "watch:html": "onchange \"src/*.html\" -- run-s build:static",
    "watch:css": "onchange \"src/scss\" -- run-s build:css",
    "watch:images": "onchange \"src/images\" -- run-s build:images"
  },
  "devDependencies": {
    "@textile/buck-util": "1.0.4",
    "autoprefixer": "^9.0.1",
    "browser-sync": "^2.12.8",
    "eslint": "^7.17.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^3.1.0",
    "imagemin-cli": "^3.0.0",
    "mkdirp": "^0.5.1",
    "node-sass": "^5.0.0",
    "npm-run-all": "^4.1.3",
    "onchange": "^4.1.0",
    "postcss-cli": "^6.0.0",
    "rimraf": "^2.5.4",
    "stylelint": "^13.8.0",
    "uglify-es": "^3.3.10"
  },
  "homepage": "https://textile.io",
  "main": ".eslintrc.js"
}
